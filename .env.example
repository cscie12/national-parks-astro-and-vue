# Copy this file to .env and put your own key in.
# Get a free key at https://www.nps.gov/subjects/developer/get-started.htm
# DEMO_KEY works for testing but is heavily rate-limited.
#
# No VITE_ / PUBLIC_ prefix: this key is only read in Astro frontmatter
# at BUILD time, so it never reaches the browser.
NPS_API_KEY=DEMO_KEY
